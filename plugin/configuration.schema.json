{
  "type": "object",
  "properties": {
    "timeout": {
      "type": "string",
      "pattern": "^0[0-6]\\.([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$",
      "default": "00.01:00:00"
    },
    "scheduleInputs": {
      "type": "object",
      "description": "Reviewed source-owner manifest views, keyed by scheduled flow. Read at each occurrence; no fixed counts or guessed delivery identities.",
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_-]*$": {
          "type": "object",
          "required": ["kind", "linkedService", "schema", "view"],
          "properties": {
            "kind": {
              "enum": ["azure-sql", "sql-server"]
            },
            "linkedService": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,100}$"
            },
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
            },
            "view": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
